<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="soft_vegetation_test">
    <static>false</static>

    <!--
      Each green stem is a rigid cylinder connected to the world with a springy
      revolute joint at its base. This approximates grass / bushes with Gazebo's
      rigid-body physics while still letting the robot push them aside.
    -->

    <link name="grass_0">
      <pose relative_to="__model__">1.15 -0.28 0.55 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.0082</ixx>
          <iyy>0.0082</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>1.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.45 0.12 1</ambient>
          <diffuse>0.10 0.75 0.18 1</diffuse>
          <specular>0.05 0.12 0.05 1</specular>
        </material>
      </visual>
      <visual name="leaf_cluster_visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.35</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.05 0.35 0.08 1</ambient>
          <diffuse>0.08 0.62 0.12 1</diffuse>
          <specular>0.03 0.08 0.03 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>1.10</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="grass_0_spring_joint" type="revolute">
      <pose relative_to="grass_0">0 0 -0.55 0 0 0</pose>
      <parent>world</parent>
      <child>grass_0</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.2</lower>
          <upper>1.2</upper>
          <effort>40</effort>
          <velocity>4</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <spring_reference>0</spring_reference>
          <spring_stiffness>6.0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="grass_1">
      <pose relative_to="__model__">1.25 -0.14 0.55 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.0082</ixx>
          <iyy>0.0082</iyy>
